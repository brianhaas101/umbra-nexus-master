{
  "version": "v1",
  "verticals_policy": {
    "open_ended": true,
    "max_active_verticals_in_ui": 5,
    "dominant_vertical_per_city": true,
    "city_can_be_good_in_A_bad_in_B": true,
    "selection_rule": "pick_max_expected_value_subject_to_risk_constraints"
  },
  "vertical_definition_template": {
    "vertical_id": "vertical_example",
    "label": "Example Vertical",
    "capital_intensity": "medium",
    "typical_sales_cycle_months": 3,
    "typical_deal_size_usd_range": {
      "min": 5000,
      "max": 5000000,
      "note": "Range is intentionally wide to allow car dealership scale through major market coverage."
    },
    "qualification_thresholds": {
      "min_city_score": 0.60,
      "min_entity_score": 60,
      "max_false_positive_rate_target": 0.05
    },
    "required_signals": ["scores.umbraScore"],
    "optional_signals": ["scores.founderScore"],
    "explainability": "approx_interpretable",
    "risk_policy": {
      "false_positive_is_worse": true,
      "allow_high_risk_high_reward": "yes_if_flagged_and_expected_value_high"
    }
  }
}
