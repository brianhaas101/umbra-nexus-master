{
  "version": "1.0.0",
  "description": "UI filter definitions for Umbra Nexus.",
  "groups": [
    {
      "id": "lead_type",
      "label": "Lead Type",
      "filters": [
        { "id": "type_private_owner", "label": "Private Owners", "condition": "leadType = 'PrivateOwner'" },
        { "id": "type_dealership", "label": "Dealerships", "condition": "leadType = 'Dealership'" },
        { "id": "type_business_fleet", "label": "Business Fleets", "condition": "leadType = 'BusinessFleet'" },
        { "id": "type_detail_shop", "label": "Detail Shops", "condition": "leadType = 'DetailShop'" }
      ]
    },
    {
      "id": "value_tier",
      "label": "Value Tier",
      "filters": [
        { "id": "tier_diamond", "label": "Diamond (Elite)", "condition": "scores.umbraScore >= 90" },
        { "id": "tier_ruby", "label": "Ruby (High Value)", "condition": "scores.umbraScore between [80,89]" },
        { "id": "tier_gold", "label": "Gold (Good)", "condition": "scores.umbraScore between [70,79]" },
        { "id": "tier_silver", "label": "Silver (Easy Wins)", "condition": "scores.umbraScore between [60,69]" }
      ]
    },
    {
      "id": "intent",
      "label": "Intent",
      "filters": [
        { "id": "intent_hot", "label": "Hot Intent (48h)", "condition": "activity.lastEventWithinHours <= 48" },
        { "id": "intent_warm", "label": "Warm (7d)", "condition": "activity.lastEventWithinDays <= 7" },
        { "id": "intent_recent", "label": "Recent (30d)", "condition": "activity.lastEventWithinDays <= 30" }
      ]
    },
    {
      "id": "founder_mode",
      "label": "Founder Mode",
      "filters": [
        { "id": "founder_high_wealth", "label": "High Net Worth", "condition": "wealth.homeEstimatedValue >= 600000" },
        { "id": "founder_high_influence", "label": "High Influence", "condition": "influence.followerCount >= 10000" },
        { "id": "founder_luxury_zone", "label": "Luxury Zones", "condition": "location.neighborhoodTier in ['HighWealthCluster','Luxury']" }
      ]
    }
  ]
}