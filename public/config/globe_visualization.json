{
  "version": "1.0.0",
  "description": "Visualization rules for mapping lead density and value to globe lighting.",
  "intensity": {
    "aggregationRadiusKm": 5,
    "formula": "sum(lead.scores.umbraScore) / area",
    "normalization": {
      "min": 0,
      "max": 5000
    }
  },
  "tiers": [
    {
      "id": "diamond_cluster",
      "label": "Diamond Cluster",
      "scoreMin": 90,
      "color": "#ff0000",
      "glowMultiplier": 1.4
    },
    {
      "id": "ruby_cluster",
      "label": "Ruby Cluster",
      "scoreMin": 80,
      "scoreMax": 89,
      "color": "#ff4500",
      "glowMultiplier": 1.2
    },
    {
      "id": "gold_cluster",
      "label": "Gold Cluster",
      "scoreMin": 70,
      "scoreMax": 79,
      "color": "#ffb300",
      "glowMultiplier": 1.0
    },
    {
      "id": "silver_speck",
      "label": "Silver Specks",
      "scoreMin": 60,
      "scoreMax": 69,
      "color": "#f5f5f5",
      "glowMultiplier": 0.7
    },
    {
      "id": "low_activity",
      "label": "Low Activity",
      "scoreMax": 59,
      "color": "#444444",
      "glowMultiplier": 0.4
    }
  ]
}