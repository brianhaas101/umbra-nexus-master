{
  "version": "1.0.0",
  "description": "Additional scoring rules applied only in Founder Mode for Black Hand Finish.",
  "enabled": true,
  "categories": {
    "wealth_status": {
      "description": "Signals of high net worth, career status, and property value.",
      "rules": [
        {
          "id": "home_high_value",
          "label": "High-value primary residence",
          "weight": 30,
          "appliesTo": ["PrivateOwner"],
          "triggers": ["wealth.homeEstimatedValue >= 600000"]
        },
        {
          "id": "home_luxury_tier",
          "label": "Luxury-tier property or gated community",
          "weight": 40,
          "appliesTo": ["PrivateOwner"],
          "triggers": ["wealth.propertyTier in ['Luxury','GatedCommunity','Estate']"]
        },
        {
          "id": "profession_high_earner",
          "label": "High-earning profession",
          "weight": 30,
          "appliesTo": ["PrivateOwner"],
          "triggers": ["profile.profession in ['Doctor','Surgeon','Lawyer','Executive','TechFounder','Investor','Entrepreneur']"]
        },
        {
          "id": "business_owner_flag",
          "label": "Known business owner",
          "weight": 25,
          "appliesTo": ["PrivateOwner"],
          "triggers": ["profile.isBusinessOwner = true"]
        }
      ]
    },
    "influence_notability": {
      "description": "Public profile, follower count, and local notoriety.",
      "rules": [
        {
          "id": "social_influence_high",
          "label": "High social media influence",
          "weight": 35,
          "appliesTo": ["PrivateOwner"],
          "triggers": ["influence.followerCount >= 10000"]
        },
        {
          "id": "local_public_figure",
          "label": "Local public figure or notable person",
          "weight": 30,
          "appliesTo": ["PrivateOwner"],
          "triggers": ["influence.isLocalPublicFigure = true"]
        },
        {
          "id": "celebrity_adjacent_zone",
          "label": "Lives in celebrity-adjacent area",
          "weight": 40,
          "appliesTo": ["PrivateOwner"],
          "triggers": ["geo.neighborhoodTier = 'HighWealthCluster'"]
        }
      ]
    },
    "privacy_security": {
      "description": "Signals of privacy consciousness that correlate with higher wealth.",
      "rules": [
        {
          "id": "high_privacy_behavior",
          "label": "High privacy behavior (blurred plates, limited home imagery)",
          "weight": 20,
          "appliesTo": ["PrivateOwner"],
          "triggers": ["behavior.privacyLevel >= 0.7"]
        },
        {
          "id": "secure_garage_storage",
          "label": "Secure garage storage with multiple vehicles",
          "weight": 25,
          "appliesTo": ["PrivateOwner"],
          "triggers": ["vehicle.storage = 'Garage' and wealth.vehicleCountGarage >= 2"]
        }
      ]
    }
  }
}