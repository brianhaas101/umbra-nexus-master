{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Black Dragon Las Vegas Contact Readiness Scores",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "entity_id",
      "entity_name",
      "city",
      "state",
      "contact_readiness_score",
      "confidence_score",
      "scoring_status",
      "outbound_contact_allowed",
      "runtime_promotion_allowed"
    ],
    "properties": {
      "entity_id": { "type": "string", "pattern": "^LV_ENTITY_[0-9]{3}$" },
      "entity_name": { "type": "string", "minLength": 1 },
      "city": { "const": "Las Vegas" },
      "state": { "const": "Nevada" },
      "contact_readiness_score": { "const": 0 },
      "confidence_score": { "const": 0 },
      "scoring_status": { "const": "NOT_READY" },
      "outbound_contact_allowed": { "const": false },
      "runtime_promotion_allowed": { "const": false }
    },
    "additionalProperties": true
  }
}
