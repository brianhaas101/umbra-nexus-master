{
  "version": "umbra_client_isolation_manifest_v1",

  "clients": [
    {
      "client_id": "black_dragon",
      "dataset_root": "public/data/clients/black_dragon",
      "runtime_scope": [
        "black_dragon"
      ],
      "forbidden_scope": [
        "founder",
        "system",
        "other_clients"
      ]
