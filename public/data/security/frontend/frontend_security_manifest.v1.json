{
  "version": "umbra_frontend_security_manifest_v1",

  "modules": [
    {
      "id": "frontend_runtime_guard",
      "path": "public/globe/security/frontend_runtime_guard.js",
      "required": true,
      "purpose": "enforce frontend runtime role checks and panel access restrictions"
    }
  ],

  "required_globals": [
    "window.UmbraFrontendSecurity"
  ],

  "required_functions": [
    "getRuntimeRole",
    "getClientId",
    "canAccessPanel",
    "requireFounder",
    "assertClientScope",
    "canExportDataset",
    "applyPanelVisibility",
    "getDebugState"
  ],

  "blocked_client_panels": [
    "FOUNDER_ADMIN",
    "CLIENT_SWITCHER",
    "SECURITY_AUDITS",
    "INTEL_REGISTRY",
    "GLOBAL_DATA",
    "SYSTEM_CONFIG",
    "EXPORTS"
  ]
}
