{
    "contract_id":  "L01_federal_entity_mapping_rules",
    "version":  "1.0.0",
    "entity_types":  [
                         "agency",
                         "program",
                         "grant",
                         "contract",
                         "award",
                         "recipient",
                         "advisory",
                         "notice",
                         "enforcement_notice",
                         "risk_signal",
                         "jurisdiction",
                         "field_office",
                         "corridor"
                     ],
    "mapping_policy":  "explicit_source_fields_only",
    "forbidden":  [
                      "synthetic_entity",
                      "inferred_contact",
                      "runtime_promoted_entity",
                      "black_dragon_runtime_reference"
                  ],
    "required_output_fields":  [
                                   "entity_id",
                                   "entity_type",
                                   "source_trace",
                                   "score_components",
                                   "evidence",
                                   "federal_context"
                               ]
}
