{
  "schema_id": "L01_connector_operational_policies",
  "version": "1.0.0",
  "throttling_policy": {
    "default_min_delay_ms": 1500,
    "max_parallel_live_fetches": 2,
    "per_source_concurrency": 1
  },
  "retry_policy": {
    "max_attempts": 2,
    "retryable_statuses": [408, 429, 500, 502, 503, 504],
    "backoff_ms": [1000, 3000],
    "fail_closed": true
  },
  "dead_source_handling": {
    "mark_status": "temporarily_unreachable",
    "emit_live_records": false,
    "affect_scores": false,
    "generate_entities": false,
    "requires_manual_reactivation": true
  },
  "client_paths_touched": false
}
