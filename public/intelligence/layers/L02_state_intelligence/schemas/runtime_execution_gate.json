{
  "contract_id": "L02_runtime_execution_gate",
  "version": "1.0.0",
  "rules": {
    "runtime_exit_code_zero_required": true,
    "runtime_token_required": true,
    "stderr_must_be_empty": true,
    "failure_markers_forbidden": true,
    "manual_pass_log_forbidden": true,
    "post_failure_pass_log_forbidden": true,
    "guarded_runtime_wrapper_required": true,
    "client_paths_touched": false
  },
  "failure_markers": [
    "STOP:",
    "SyntaxError",
    "MODULE_NOT_FOUND",
    "FETCH_ERROR",
    "Cannot use import statement outside a module",
    "Error:"
  ]
}
