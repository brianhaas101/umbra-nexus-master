{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "umbra.nexus.black_dragon.lead_output.schema.v1",
  "title": "Umbra Nexus Black Dragon Lead Output Schema",
  "description": "Locked lead output schema for Black Dragon / OutlawMotorcycleGangCert.com dossier-ready entities.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "entity_id",
    "agency_id",
    "client_id",
    "full_name",
    "title",
    "agency_name",
    "state",
    "country",
    "email",
    "phone",
    "signals_summary",
    "scores",
    "tier",
    "confidence",
    "recommended_outreach_angle"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "agency_id": {
      "type": "string",
      "minLength": 1
    },
    "client_id": {
      "type": "string",
      "const": "black_dragon_omg_cert_v1"
    },
    "full_name": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "agency_name": {
      "type": "string",
      "minLength": 1
    },
    "agency_type": {
      "type": "string"
    },
    "agency_size": {
      "type": ["number", "integer", "null"],
      "minimum": 0
    },
    "state": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32
    },
    "country": {
      "type": "string",
      "default": "US"
    },
    "email": {
      "type": "string",
      "minLength": 1
    },
    "phone": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": ["string", "null"]
    },
    "source_name": {
      "type": ["string", "null"]
    },
    "source_date": {
      "type": ["string", "null"]
    },
    "signals": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "signals_summary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "disqualifiers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scores": {
      "type": "object",
      "required": ["umbraScore", "blackDragonScore"],
      "properties": {
        "umbraScore": {
          "type": "number"
        },
        "blackDragonScore": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "tier": {
      "type": "string",
      "enum": ["HOT", "WARM", "COLD"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "recommended_outreach_angle": {
      "type": "string",
      "minLength": 1
    },
    "dossier": {
      "type": "object",
      "additionalProperties": true
    }
  }
}