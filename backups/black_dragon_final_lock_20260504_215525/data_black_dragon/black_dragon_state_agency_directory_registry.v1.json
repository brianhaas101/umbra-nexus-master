{
  "client_id": "black_dragon_omg_cert_v1",
  "version": "v1",
  "purpose": "Nationwide verified agency directory layer for Black Dragon. Used to expand top-50 city coverage from official state POST, criminal justice, and law enforcement directory sources.",
  "policy": {
    "no_placeholders": true,
    "no_hypothetical_agencies": true,
    "public_or_authorized_sources_only": true,
    "each_entity_requires_source_url": true,
    "each_import_requires_city_state_match": true,
    "live_import_allowed": false,
    "manual_review_required_before_client_action": true
  },
  "coverage_goal": {
    "required_city_count": 50,
    "target_minimum_per_city": 3,
    "ideal_per_city": 5,
    "priority_entity_types": [
      "municipal_police_department",
      "county_sheriff_office",
      "state_public_safety_or_training_authority",
      "gang_or_organized_crime_unit_if_officially_published"
    ]
  },
