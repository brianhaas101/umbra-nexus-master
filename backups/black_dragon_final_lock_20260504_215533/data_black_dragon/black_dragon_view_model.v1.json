{
  "client_id": "black_dragon_omg_cert_v1",
  "version": "v1",
  "purpose": "Defines what Black Dragon can see, use, filter, and act on inside Nexus.",

  "client_access_model": {
    "can_view": [
      "city_market_view",
      "ranked_leads",
      "lead_dossiers",
      "agency_profiles",
      "contact_paths",
      "outreach_angles",
      "source_summaries"
    ],
    "cannot_view": [
      "admin_controls",
      "founder_controls",
      "raw_system_config",
      "internal_weight_math",
      "other_client_accounts",
      "developer_logs",
      "private_source_keys"
    ]
  },

  "primary_views": {
    "world_view": {
      "description": "Shows major cities and market density.",
      "visible_fields": [
        "city_name",
        "state",
        "total_entities",
        "hot_count",
        "warm_count",
        "cold_count"
      ],
      "default_sort": "hot_count_desc"
    },

    "city_view": {
      "description": "Shows all Black Dragon-relevant entities inside a selected city.",
      "visible_fields": [
        "agency_name",
        "agency_type",
        "tier",
        "score",
        "top_signals",
        "contact_status"
      ],
      "default_sort": "score_desc",
      "filters": [
        "tier",
        "agency_type",
        "training_authority",
        "law_enforcement_only",
        "contact_available"
      ]
    },

    "lead_dossier": {
      "description": "Explains why a target matters and how to approach it.",
      "visible_fields": [
        "agency_name",
        "agency_type",
        "city",
        "state",
        "tier",
        "score",
        "signals_summary",
        "source_name",
        "source_url",
        "source_text_summary",
        "contact_url",
        "recommended_outreach_angle"
      ],
      "hidden_fields": [
        "rawScore",
        "baseSignalScore",
        "densityBonus",
        "internal_weight_values",
        "developer_trace"
      ]
    }
  },

  "lead_card_model": {
    "display_fields": [
      "agency_name",
      "city",
      "state",
      "agency_type",
      "tier",
      "score"
    ],
    "badges": [
      "HOT",
      "WARM",
      "COLD",
      "Training Authority",
      "Gang Unit",
      "Task Force",
      "Contact Path"
    ],
    "primary_action": "Open Dossier",
    "secondary_actions": [
      "Open Source",
      "Open Contact Path",
      "Copy Outreach Angle"
    ]
  },

  "dossier_language_rules": {
    "tone": "direct, professional, law-enforcement training oriented",
    "avoid": [
      "hype",
      "unverified claims",
      "private individual profiling",
      "raw investigative language"
    ],
    "must_include": [
      "why_this_target_matters",
      "what_signal_triggered_the_rank",
      "what_to_do_next"
    ]
  },

  "filter_rules": {
    "default_filters": {
      "show_law_enforcement": true,
      "show_training_authorities": true,
      "show_associations": true,
      "show_private_security": false,
      "show_cold": true
    },
    "private_security_rule": "Private security entities are hidden by default unless verified as law-enforcement-adjacent training buyers.",
    "cold_lead_rule": "Cold leads remain visible for market completeness but should not appear in the default action queue."
  },

  "priority_queue_rules": {
    "default_queue": "HOT then WARM",
    "minimum_actionable_score": 45,
    "hot_score_min": 75,
    "warm_score_min": 45,
    "max_default_queue_size": 10,
    "queue_fields": [
      "agency_name",
      "tier",
      "score",
      "contact_url",
      "recommended_outreach_angle"
    ]
  },

  "source_display_rules": {
    "show_source_name": true,
    "show_source_url": true,
    "show_source_date": true,
    "show_source_text_summary": true,
    "hide_raw_source_blob": true
  },

  "city_market_rules": {
    "city_cluster_minimum": 3,
    "priority_city_target": "5-10 relevant entities",
    "major_city_target": "3-5 relevant entities",
    "required_city_entity_types": [
      "police_department",
      "sheriff_office",
      "gang_unit",
      "task_force",
      "training_authority"
    ]
  },

  "client_safety_rules": {
    "no_admin_actions": true,
    "no_user_switching": true,
    "no_raw_json_editing": true,
    "no_other_client_visibility": true,
    "no_internal_scoring_controls": true
  },

  "completion_standard": {
    "usable_when": [
      "each priority city has at least 3 entities",
      "each lead has a dossier",
      "each lead has at least one source",
      "all HOT/WARM leads have an outreach angle",
      "client can filter by city, tier, and agency type"
    ],
    "phase_2_done_when": [
      "50-100 verified leads exist",
      "5-10 HOT leads exist",
      "20-35 WARM leads exist",
      "all priority cities have city clusters"
    ]
  }
}