{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Umbra Nexus Geospatial Provenance Record",
  "type": "object",
  "required": [
    "city_id",
    "canonical_name",
    "source_name",
    "source_type",
    "source_url",
    "source_license",
    "retrieval_timestamp",
    "raw_artifact_path",
    "raw_artifact_sha256",
    "geometry_format",
    "original_crs",
    "normalized_crs",
    "bbox",
    "geometry_sha256",
    "mutation_allowed"
  ],
  "properties": {
    "city_id": {
      "type": "string"
    },
    "canonical_name": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "source_type": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source_license": {
      "type": "string"
    },
    "retrieval_timestamp": {
      "type": "string"
    },
    "raw_artifact_path": {
      "type": "string"
    },
    "raw_artifact_sha256": {
      "type": "string"
    },
    "geometry_format": {
      "type": "string"
    },
    "original_crs": {
      "type": "string"
    },
    "normalized_crs": {
      "type": "string",
      "const": "EPSG:4326"
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "geometry_sha256": {
      "type": "string"
    },
    "spatial_confidence_class": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "E"]
    },
    "verification_status": {
      "type": "string"
    },
    "mutation_allowed": {
      "type": "boolean",
      "const": false
    }
  }
}