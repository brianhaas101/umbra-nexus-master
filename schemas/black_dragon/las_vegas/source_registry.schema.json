{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Black Dragon Las Vegas Source Registry",
  "type": "object",
  "required": ["version", "city_scope", "approved_sources", "hardlocks"],
  "properties": {
    "city_scope": {
      "type": "object",
      "required": [
        "city",
        "state",
        "state_code",
        "statewide_expansion_forbidden",
        "unmapped_city_ingestion_forbidden",
        "runtime_city_creation_forbidden"
      ],
      "properties": {
        "city": { "const": "Las Vegas" },
        "state": { "const": "Nevada" },
        "state_code": { "const": "NV" },
        "statewide_expansion_forbidden": { "const": true },
        "unmapped_city_ingestion_forbidden": { "const": true },
        "runtime_city_creation_forbidden": { "const": true }
      }
    },
    "approved_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "source_name",
          "category",
          "ingestion_status",
          "quarantine_required",
          "runtime_promotion_allowed"
        ],
        "properties": {
          "source_id": { "type": "string", "pattern": "^LV_SRC_[0-9]{3}$" },
          "source_name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "ingestion_status": {
            "enum": ["APPROVED", "APPROVED_LIMITED"]
          },
          "quarantine_required": { "const": true },
          "runtime_promotion_allowed": { "const": false }
        }
      }
    },
    "hardlocks": {
      "type": "object",
      "required": [
        "no_auto_contact",
        "no_auto_promotion",
        "no_runtime_mutation",
        "quarantine_before_runtime",
        "manual_review_required_for_contact"
      ],
      "properties": {
        "no_auto_contact": { "const": true },
        "no_auto_promotion": { "const": true },
        "no_runtime_mutation": { "const": true },
        "quarantine_before_runtime": { "const": true },
        "manual_review_required_for_contact": { "const": true }
      }
    }
  },
  "additionalProperties": true
}
