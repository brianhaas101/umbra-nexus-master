{
  "contract_id": "L02_source_discovery_contract",
  "version": "0.1.0",
  "batch_size": 3,
  "registered_sources": [
    "state_open_data_portals",
    "state_emergency_management",
    "state_police_public_safety"
  ],
  "discovery_rules": {
    "live_activation_allowed": false,
    "registry_mutation_after_failed_probe": false,
    "state_local_provenance_required": true,
    "source_url_required": true,
    "state_code_required": true,
    "no_l01_mutation": true,
    "no_client_path_mutation": true,
    "synthetic_fillers_allowed": false,
    "inferred_contacts_allowed": false
  },
  "client_paths_touched": false
}
