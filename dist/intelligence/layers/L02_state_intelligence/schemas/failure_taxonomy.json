{
  "taxonomy_id": "L02_failure_taxonomy",
  "version": "1.0.0",
  "failure_classes": [
    "fetch_error",
    "http_error",
    "blocked_or_challenge_page",
    "payload_too_small",
    "identity_markers_missing",
    "category_signals_missing",
    "normalizer_failure",
    "runtime_failure",
    "registry_merge_failure"
  ],
  "rules": {
    "failed_target_must_defer": true,
    "failed_target_must_not_promote": true,
    "failure_reason_required": true,
    "synthetic_fallback_forbidden": true,
    "client_paths_touched": false
  }
}