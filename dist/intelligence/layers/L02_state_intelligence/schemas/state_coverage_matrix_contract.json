    "categories_required_per_state": 15,
    "total_state_source_targets": 750,
    "districts_and_territories": "future_expansion_not_required_for_L02_completion"
  },
  "required_categories": [
    "state_open_data_portals",
    "state_emergency_management",
    "state_police_public_safety",
    "state_courts",
    "state_environmental_agency",
    "state_transportation",
    "state_labor_workforce",
    "state_housing",
    "state_education",
    "state_health_services",
    "state_energy_utilities",
    "state_business_regulation",
    "state_procurement",
    "state_corrections",
    "state_elections"
  ],
  "rules": {
    "every_state_must_have_all_categories_accounted": true,
    "live_verified_preferred": true,
    "blocked_sources_must_be_deferred_with_reason": true,
    "replacement_sources_must_be_state_official": true,
    "no_synthetic_fillers": true,
    "no_inferred_contacts": true,
