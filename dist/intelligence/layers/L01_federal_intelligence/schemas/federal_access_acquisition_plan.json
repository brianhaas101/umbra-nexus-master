      "policy": "replacement sources must be federal, public, replay-safe, and provenance-valid"
    },
    "track_b_access_acquisition": {
      "goal": "obtain official permissions/keys for protected federal systems",
      "policy": "deferred sources remain locked until pass-token verification succeeds"
    }
  },
  "protected_sources": [
    {
      "source_id": "sam_gov",
      "status": "permission_or_endpoint_required",
      "action": "request/verify official SAM.gov API access"
    },
    {
      "source_id": "fbi_crime_data_explorer",
      "status": "api_key_present_endpoint_unstable",
      "action": "confirm official CDE endpoint documentation or support path"
    },
    {
      "source_id": "fbi_ucr",
      "status": "api_key_present_endpoint_unstable",
      "action": "confirm official UCR endpoint documentation or dataset path"
    },
    {
      "source_id": "fbi_press_releases",
      "status": "http_403_blocked",
      "action": "seek RSS/static export/permissioned machine access"
    },
    {
      "source_id": "fbi_field_offices",
      "status": "http_403_blocked",
      "action": "seek static export/permissioned machine access"
    }
  ],
  "immediate_replacement_candidates": [
    "cisa_advisories",
    "grants_gov_opportunities",
    "ojp_awards",
    "data_gov_crime_catalog",
    "fema_open_data"
  ],
  "completion_standard": {
    "no_synthetic_fillers": true,
    "no_unverified_live_status": true,
    "pass_token_required_for_activation": true,
    "all_sources_must_emit_provenance": true,
    "all_sources_must_bridge_to_pipe01": true,
    "all_sources_must_support_replay_hashing": true
  },
  "client_paths_touched": false
