{
    "contract_id":  "L01_connector_parser_contract",
    "version":  "1.0.0",
    "connector_output":  "raw_federal_source_record",
    "connector_must":  [
                           "fail_closed",
                           "emit_only_explicit_source_records",
                           "include_canonical_url",
                           "include_retrieved_at",
                           "include_source_trace",
                           "avoid_runtime_promotion",
                           "avoid_synthetic_fillers"
                       ],
    "connector_must_not":  [
                               "write_black_dragon_paths",
                               "modify_globe_runtime",
                               "infer_contacts",
                               "invent_entities",
                               "activate_without_policy"
                           ],
    "allowed_runtime_modules":  [
                                    "node:fs",
                                    "node:path",
                                    "node:crypto",
                                    "global_fetch",
                                    "URL"
                                ]
}
