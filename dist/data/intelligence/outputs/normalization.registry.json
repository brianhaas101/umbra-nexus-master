{
  "version": "umbra_intelligence_normalization_registry_v1",
  "generated_at": "2026-05-05",
  "system": "Umbra Nexus",
  "rule": "Every raw source must normalize into stable entities, evidence, signals, scores, and dossier fields before entering client-facing output.",
  "normalization_units": {
    "entity": {
      "required_fields": [
        "entity_id",
        "agency_name",
        "entity_type",
        "city",
        "state",
        "country",
        "source_trace",
        "confidence"
      ]
    },
    "evidence": {
      "required_fields": [
        "evidence_id",
        "layer_id",
        "source_url",
        "source_type",
        "claim",
        "observed_value",
        "verified_at",
        "confidence"
      ]
    },
    "signal": {
      "required_fields": [
        "signal_id",
        "entity_id",
        "layer_id",
        "signal_type",
        "signal_value",
        "operational_relevance",
        "confidence"
      ]
    },
    "score_component": {
      "required_fields": [
        "entity_id",
        "layer_id",
        "component_name",
        "component_score",
        "weight",
        "reason"
      ]
    },
    "dossier_field": {
      "required_fields": [
        "entity_id",
        "field_group",
        "field_name",
        "value",
        "source_trace",
        "confidence"
      ]
    }
  },
  "confidence_scale": {
    "1.0": "official source directly verifies claim",
    "0.85": "official source strongly supports claim",
    "0.7": "official source indirectly supports claim",
    "0.5": "inference from partial official source",
    "0.0": "unverified or blocked"
  },
  "layer_output_rules": [
    {
      "layer_id": "L02_STATE_INTELLIGENCE",
      "normalized_outputs": [
        "state_source_verified",
        "state_candidate_agency",
        "state_coverage_status"
      ],
      "minimum_confidence_for_candidate": 0.7,
      "minimum_confidence_for_verified": 0.85
    },
    {
      "layer_id": "L03_LOCAL_AGENCY_INTELLIGENCE",
      "normalized_outputs": [
        "official_agency_identity",
        "agency_type",
        "jurisdiction"
      ],
      "minimum_confidence_for_candidate": 0.7,
      "minimum_confidence_for_verified": 0.85
    },
    {
      "layer_id": "L04_TRAINING_INFRASTRUCTURE",
      "normalized_outputs": [
        "training_function_exists",
        "training_department_path",
        "academy_or_field_training_path"
      ],
      "minimum_confidence_for_candidate": 0.7,
      "minimum_confidence_for_verified": 0.85
    },
    {
      "layer_id": "L10_COMMUNICATION_CHANNELS",
      "normalized_outputs": [
        "verified_phone_path",
        "fallback_route",
        "official_contact_url"
      ],
      "minimum_confidence_for_candidate": 0.7,
      "minimum_confidence_for_verified": 0.9
    }
  ],
  "blocked_outputs": [
    "fake_phone",
    "generic_email_as_final_contact",
    "third_party_only_contact",
    "court_or_prosecutor_unless_explicit_client_rule",
    "unverified_outreach_ready_status"
  ]
}
