{
  "version": "black_dragon_books_tracking_status_model_v1",

  "allowed_statuses": [
    "NOT_CONTACTED",
    "CONTACTED",
    "RESPONDED",
    "INTERESTED",
    "ENDORSED",
    "BULK_ORDER",
    "CLOSED",
    "NOT_A_FIT",
    "NO_RESPONSE"
  ],

  "propagation_result_fields": [
    "contacted_at",
    "responded_at",
    "endorsed_at",
    "closed_at",
    "books_ordered",
    "estimated_member_orders",
    "estimated_revenue",
    "endorsement_type",
    "followup_required",
    "next_action"
  ],

  "hard_rules": {
    "status_must_be_allowed": true,
    "closed_requires_estimated_revenue": true,
    "bulk_order_requires_books_ordered": true,
    "endorsed_requires_endorsement_type": true
  }
}
