{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Black Dragon Las Vegas Entity Schema Contract",
  "type": "object",
  "required": [
    "version",
    "required_fields",
    "allowed_values",
    "forbidden_conditions",
    "enforcement"
  ],
  "properties": {
    "required_fields": {
      "type": "array",
      "contains": { "const": "entity_id" }
    },
    "allowed_values": {
      "type": "object",
      "required": [
        "city",
        "state",
        "state_code",
        "quarantine_status",
        "manual_review_status",
        "contact_readiness",
        "runtime_eligible",
        "synthetic_entity"
      ],
      "properties": {
        "city": { "type": "array", "contains": { "const": "Las Vegas" } },
        "state": { "type": "array", "contains": { "const": "Nevada" } },
        "state_code": { "type": "array", "contains": { "const": "NV" } },
        "quarantine_status": { "type": "array", "contains": { "const": "QUARANTINED" } },
        "manual_review_status": { "type": "array", "contains": { "const": "REQUIRED" } },
        "contact_readiness": { "type": "array", "contains": { "const": "NOT_REVIEWED" } },
        "runtime_eligible": { "type": "array", "contains": { "const": false } },
        "synthetic_entity": { "type": "array", "contains": { "const": false } }
      }
    },
    "forbidden_conditions": {
      "type": "array",
      "contains": { "const": "unmapped_city_expansion" }
    },
    "enforcement": {
      "type": "object",
      "required": [
        "ajv_validation_required",
        "jq_json_validation_required",
        "quarantine_default_required",
        "runtime_promotion_allowed"
      ],
      "properties": {
        "ajv_validation_required": { "const": true },
        "jq_json_validation_required": { "const": true },
        "quarantine_default_required": { "const": true },
        "runtime_promotion_allowed": { "const": false }
      }
    }
  },
  "additionalProperties": true
}
