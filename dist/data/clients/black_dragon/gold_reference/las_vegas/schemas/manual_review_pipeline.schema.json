{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Black Dragon Las Vegas Manual Review Pipeline",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "queue_id",
      "entity_id",
      "entity_name",
      "city",
      "state",
      "review_type",
      "review_status",
      "runtime_promotion_allowed",
      "outbound_contact_allowed"
    ],
    "properties": {
      "queue_id": { "type": "string", "pattern": "^QUEUE_LV_ENTITY_[0-9]{3}$" },
      "entity_id": { "type": "string", "pattern": "^LV_ENTITY_[0-9]{3}$" },
      "entity_name": { "type": "string", "minLength": 1 },
      "city": { "const": "Las Vegas" },
      "state": { "const": "Nevada" },
      "review_type": { "const": "MANUAL_CONTACT_REVIEW" },
      "review_status": { "const": "PENDING" },
      "runtime_promotion_allowed": { "const": false },
      "outbound_contact_allowed": { "const": false }
    },
    "additionalProperties": true
  }
}
