{
  "version": "umbra_ui_security_integration_manifest_v1",

  "required_scripts_in_order": [
    "public/globe/security/frontend_runtime_guard.js",
    "public/globe/security/ui_panel_security_hook.js"
  ],

  "required_globals": [
    "window.UmbraFrontendSecurity",
    "window.UmbraUIPanelSecurity"
  ],

  "panel_marker_contract": {
    "founder_admin": "data-founder-only",
    "client_switcher": "data-client-switcher",
    "security_audits": "data-security-audits",
    "intel_registry": "data-intel-registry",
    "global_data": "data-global-data",
    "system_config": "data-system-config",
    "exports": "data-export-control",
    "black_dragon_books": "data-black-dragon-books",
    "outreach_queue": "data-outreach-queue",
    "target_view": "data-target-view",
    "response_log": "data-response-log",
    "kpi_summary": "data-kpi-summary"
  },

  "client_operator_must_block": [
    "FOUNDER_ADMIN",
    "CLIENT_SWITCHER",
    "SECURITY_AUDITS",
    "INTEL_REGISTRY",
    "GLOBAL_DATA",
    "SYSTEM_CONFIG",
    "EXPORTS"
  ],

  "client_operator_must_allow": [
    "BLACK_DRAGON_BOOKS",
    "OUTREACH_QUEUE",
    "TARGET_VIEW",
    "RESPONSE_LOG",
    "KPI_SUMMARY"
  ]
}
