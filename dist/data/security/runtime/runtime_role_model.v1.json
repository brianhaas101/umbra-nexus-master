{
  "version": "umbra_runtime_role_model_v1",

  "roles": {

    "FOUNDER": {
      "runtime_admin": true,
      "client_switching": true,
      "intel_registry_access": true,
      "dataset_export": true,
      "security_audit_access": true,
      "adaptive_priority_admin": true,
      "response_ingestion_admin": true,
      "system_config_access": true
    },

    "CLIENT_OPERATOR": {
      "runtime_admin": false,
      "client_switching": false,
      "intel_registry_access": false,
      "dataset_export": false,
      "security_audit_access": false,
      "adaptive_priority_admin": false,
      "response_ingestion_admin": false,
      "system_config_access": false
    }
  },

  "runtime_rules": {
    "strict_client_isolation": true,
    "cross_client_visibility_forbidden": true,
    "founder_runtime_required_for_admin_actions": true,
    "client_export_restricted": true,
    "runtime_mutation_protection": true
  }
}
