{
  "version": "umbra_export_security_policy_v1",

  "founder_permissions": {
    "raw_dataset_export": true,
    "global_export": true,
    "cross_client_export": true,
    "security_export": true
  },

  "client_operator_permissions": {
    "raw_dataset_export": false,
    "global_export": false,
    "cross_client_export": false,
    "security_export": false
  },

  "allowed_client_exports": [
    "client_summary",
    "outreach_queue",
    "response_log",
    "kpi_snapshot"
  ],

  "hard_rules": {
    "raw_global_export_forbidden_for_clients": true,
    "cross_client_export_forbidden": true,
    "founder_role_required_for_global_exports": true,
    "client_scope_validation_required": true
  }
}
